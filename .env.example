# MAIOS environment template.
# Copy this file to `.env` and fill in only what you use.
# Values already set in the process environment win over this file.

# Default LLM provider: mock | openai | claude | gemini
MAIOS_MODEL_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
